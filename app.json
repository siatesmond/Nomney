{
  "expo": {
    "name": "Nomney",
    "slug": "Nomney",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon/icon_v1.png",
    "scheme": "nomney",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon/mascotWithLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Nomney",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBIp6HylDldDd3TCAXEmqlq3csxOhdnhMI"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon/icon_v1.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Nomney"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(BUNDLE_DISPLAY_NAME) to access your photos.",
          "cameraPermission": "Allow $(BUNDLE_DISPLAY_NAME) to use your camera."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(BUNDLE_DISPLAY_NAME) to use your location."
        }
      ],
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        { "iosUrlScheme": "com.googleusercontent.apps.placeholder" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5e5e1b4a-4400-4b50-8a8f-7e8c07dd2cf2"
      }
    },
    "owner": "tesmondsia"
  }
}
