{
  "expo": {
    "name": "Nomney",
    "slug": "Nomney",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon/icon_v1_square.png",
    "scheme": "nomney",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Nomney",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBIp6HylDldDd3TCAXEmqlq3csxOhdnhMI"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon/icon_v1_square.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Nomney",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon/mascotWithLogo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 200
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "StreakSmall",
              "label": "Nomney Streak (Small)",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "description": "Compact view of your meal-logging streak",
              "previewImage": "./assets/images/StreakWidgetSmall.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "StreakLarge",
              "label": "Nomney Streak (Large)",
              "minWidth": "320dp",
              "minHeight": "120dp",
              "targetCellWidth": 5,
              "targetCellHeight": 2,
              "description": "Full view with your streak, best, and mascot",
              "previewImage": "./assets/images/StreakWidgetLarge.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(BUNDLE_DISPLAY_NAME) to access your photos.",
          "cameraPermission": "Allow $(BUNDLE_DISPLAY_NAME) to use your camera."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(BUNDLE_DISPLAY_NAME) to use your location."
        }
      ],
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.placeholder"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f66243a7-8ac9-4c28-957e-7bf12ca40e67"
      }
    },
    "owner": "tesmondsiajiajin",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f66243a7-8ac9-4c28-957e-7bf12ca40e67"
    }
  }
}
